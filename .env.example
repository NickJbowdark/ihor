# Copy this file to ".env" and adjust. ".env" is git-ignored: put secrets ONLY there.

# Where the SQLite database lives (relative to the project root)
GIM_DB_PATH=data/gim.sqlite3

# Logging
GIM_LOG_DIR=logs
GIM_LOG_LEVEL=INFO

# GDELT asks clients to stay at or below ~1 request every 5 seconds.
GIM_GDELT_MIN_INTERVAL_S=6
GIM_HTTP_TIMEOUT_S=30

# Identify your client honestly. Replace the contact URL with your repo or homepage.
GIM_USER_AGENT=GIM-Research-Monitor/0.1 (+https://github.com/your-account/your-repo)

# Restrict GDELT results to one language ("english") or use "any".
GIM_GDELT_LANGUAGE=english

# --- Phase 3 (not used yet) ---
# Any OpenAI-compatible endpoint works: DeepSeek, Ollama (http://localhost:11434/v1), etc.
# GIM_LLM_BASE_URL=https://api.deepseek.com
# GIM_LLM_MODEL=copy-the-exact-id-from-the-provider-docs
# GIM_LLM_API_KEY=
# GIM_LLM_MONTHLY_BUDGET_USD=5
