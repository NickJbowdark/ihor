# Copy this file to ".env" and adjust. ".env" is git-ignored: put secrets ONLY there.
# GIM redacts the values of credential variables (names containing KEY, TOKEN, SECRET,
# PASSWORD, APPNAME, EMAIL, ...) from logs, error messages, reports and recorded fixtures.

# Where the SQLite database lives (relative to the project root)
GIM_DB_PATH=data/gim.sqlite3

# Logging
GIM_LOG_DIR=logs
GIM_LOG_LEVEL=INFO

# GDELT asks clients to stay at or below ~1 request every 5 seconds.
GIM_GDELT_MIN_INTERVAL_S=6
GIM_HTTP_TIMEOUT_S=30

# Identify your client honestly. Replace the contact URL with your repo or homepage.
GIM_USER_AGENT=GIM-Research-Monitor/0.1 (+https://github.com/your-account/your-repo)

# Restrict GDELT results to one language ("english") or use "any".
GIM_GDELT_LANGUAGE=english

# --- Source credentials (Phase 2). Leave empty until you have them; the source then
# shows "needs credentials" on the Source health page instead of failing. ---
# ReliefWeb: request a pre-approved appname at https://apidoc.reliefweb.int/
GIM_RELIEFWEB_APPNAME=
# Planned connectors (next increments):
# GIM_UCDP_TOKEN=            # requested from UCDP by e-mail; sent as header x-ucdp-access-token
# GIM_ACLED_EMAIL=           # myACLED account (OAuth password grant)
# GIM_ACLED_PASSWORD=
# GIM_HDX_APP_IDENTIFIER=

# --- AI analysis engine (Phase 3) ---------------------------------------------
# none | deepseek | ollama | openai_compatible.  "none" = deterministic baseline, no AI.
GIM_LLM_PROVIDER=none
# Leave empty to use the provider default (deepseek: https://api.deepseek.com,
# ollama: http://localhost:11434/v1). Must be https:// except for localhost.
GIM_LLM_BASE_URL=
# EXACT model id -- copy it from api-docs.deepseek.com, or from `ollama list`. Never guessed by GIM.
GIM_LLM_MODEL=
# API key (DeepSeek / other paid providers). Not needed for Ollama. Redacted everywhere.
GIM_LLM_API_KEY=
# USD per million tokens, copied from the provider's pricing page. Required for paid providers,
# so the budget cap can work. Ollama: leave 0.
GIM_LLM_PRICE_INPUT_PER_M=0
GIM_LLM_PRICE_OUTPUT_PER_M=0
# Hard monthly spending cap: calls that could exceed it are refused BEFORE they are sent.
GIM_LLM_MONTHLY_BUDGET_USD=5
GIM_LLM_MAX_OUTPUT_TOKENS=4000
GIM_LLM_TEMPERATURE=0.2
GIM_LLM_TIMEOUT_S=180
# Ask for JSON output (response_format). Set false if your model/server rejects it.
GIM_LLM_JSON_MODE=true

# --- Dashboard access ---------------------------------------------------------
# Optional login. Store the SHA-256 HASH, not the password:  python -m gim.ui.auth
# Required as a second layer when the dashboard runs on a server (see docs/DEPLOYMENT.md).
GIM_DASHBOARD_PASSWORD_SHA256=

# --- E-mail delivery of reports (optional) ------------------------------------
# Nothing is sent unless these are set. 587 = STARTTLS, 465 = TLS.
GIM_SMTP_HOST=
GIM_SMTP_PORT=587
GIM_SMTP_USER=
GIM_SMTP_PASSWORD=
GIM_EMAIL_FROM=
GIM_EMAIL_TO=
